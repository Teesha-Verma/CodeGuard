# ============================================================
# CodeGuard V2 — Production Hardened .gitignore
# ============================================================

# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================
.env
.env.*
*.env
*.env.local
*.env.development
*.env.production
*.env.test
**/.env
**/.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Explicitly preserve template / example files
!.env.example
!**/.env.example
!.env.template
!**/.env.template
!backend/.env.example
!frontend/.env.example

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

.mypy_cache/
.pyre/
.ruff_cache/
.pytype/
.hypothesis/

.tox/
.nox/

.ipynb_checkpoints/

# ============================================================
# VIRTUAL ENVIRONMENTS
# ============================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/
backend/env/

# ============================================================
# NODE / FRONTEND
# ============================================================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

frontend/dist/
frontend/dist-ssr/
frontend/out/
frontend/.next/
frontend/.nuxt/
frontend/.cache/
frontend/.vite/
dist/
build/
out/
.next/
.nuxt/
.cache/
.vite/
.turbo/
.vercel/

