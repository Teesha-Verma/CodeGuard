# ============================================================
# CodeGuard V2 — Root .dockerignore
# ============================================================

# Version Control
.git/
.gitignore

# Environment & Secrets
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
backend/.venv/
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Local Data & Logs
*.db
*.sqlite
*.sqlite3
data/
backend/data/
repos/
backend/repos/
logs/
*.log
*.trace

# RAG Vector Caches
vector_store/
embeddings_cache/
rag_cache/
*.faiss
*.index

# OS & Temp
.DS_Store
Thumbs.db
tmp/
temp/
