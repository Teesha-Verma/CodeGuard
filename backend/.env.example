# ──────────────────────────────────────────────────────────────────
# CodeGuard V2 — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────

# ── APPLICATION ───────────────────────────────────────────────────
APP_NAME=CodeGuard
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── DATABASE (PostgreSQL / Supabase) ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codeguard
POSTGRES_USER=codeguard
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
ALEMBIC_DATABASE_URL=

# ── DATABASE CONNECTION POOLING ───────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── GITHUB ────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=30

# ── GEMINI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=3

# ── LLM ───────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ── RAG ───────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_MAX_CONTEXT_CHUNKS=10
RAG_MAX_CONTEXT_TOKENS=8000
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600
RAG_VECTOR_STORE=memory
RAG_KNOWLEDGE_PATH=app/analysis/RAG/knowledge

# ── EMBEDDINGS ────────────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# ── ANALYSIS ──────────────────────────────────────────────────────
MAX_FILE_SIZE_KB=500
MAX_DIFF_FILES=50
CONTEXT_WINDOW_LINES=10
AST_ENABLED=true
CFG_ENABLED=true
CALL_GRAPH_ENABLED=true
DATAFLOW_ENABLED=true
REPOSITORY_INTELLIGENCE_ENABLED=true
LINTERS_ENABLED=true

# ── STATIC ANALYSIS ───────────────────────────────────────────────
PYLINT_ENABLED=true
FLAKE8_ENABLED=true
BANDIT_ENABLED=true

# ── PIPELINE ──────────────────────────────────────────────────────
PIPELINE_TIMEOUT=300
PIPELINE_MAX_WORKERS=4
BACKGROUND_TASKS_ENABLED=true

# ── STORAGE ───────────────────────────────────────────────────────
REPOS_DIR=repos
DATA_DIR=data
REVIEW_DATA_DIR=data/reviews
LOG_DIR=logs

# ── OBSERVABILITY ─────────────────────────────────────────────────
TRACE_ENABLED=true
LLM_TELEMETRY_ENABLED=true
TRACE_LOG_LEVEL=INFO

# ── EVALUATION ────────────────────────────────────────────────────
EVALUATION_ENABLED=true
GOLDEN_DATASET_PATH=data/evaluation
EVALUATION_OUTPUT_PATH=data/evaluation/results

# ── SECURITY ──────────────────────────────────────────────────────
API_AUTH_ENABLED=false
